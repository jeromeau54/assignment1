# Private SSH key generated by Terraform — never commit this
*.pem

# Terragrunt / Terraform cache and generated files
.terragrunt-cache/
.terraform/
.terraform.lock.hcl

# Local state files — stored in tfstate/ on this machine, never pushed
tfstate/
terraform.tfstate
terraform.tfstate.backup

# Terragrunt auto-generated backend and provider files
backend.tf
provider.tf

# Secrets — never commit
.env

# Local variable overrides
*.auto.tfvars
terraform.tfvars
